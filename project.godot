[internationalization]

locale/fallback="fr"

[rendering]

rendering_device/fallback_to_opengl3.mobile=true
textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.039, 0.031, 0.051, 1)
